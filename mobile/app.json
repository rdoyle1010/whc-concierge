{
  "expo": {
    "name": "Wellness House Talent",
    "slug": "talent-wellness-house",
    "scheme": "whctalent",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Wellness House uses your photo library only when you choose property images to add to your employer profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wellnesshousecollective.talent",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.wellnesshousecollective.talent",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "talent.wellnesshousecollective.co.uk",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "extra": {
      "eas": {
        "projectId": "ee17e15e-3c92-492a-9756-98f37c3aa316"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}

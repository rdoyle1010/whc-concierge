{
  "expo": {
    "name": "Wellness House Talent",
    "slug": "wellness-house-talent",
    "scheme": "whctalent",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "platform-updates",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wellness House uses your photo library only when you choose property images to add to your employer profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wellnesshousecollective.talent",
      "associatedDomains": ["applinks:talent.wellnesshousecollective.co.uk"]
    },
    "android": {
      "package": "com.wellnesshousecollective.talent",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "talent.wellnesshousecollective.co.uk",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}